# ============================================================
# Smarts Lever — Environment template
#
# Copy to .env for local development:
#   cp .env.example .env
#
# On Vercel: Project Settings -> Environment Variables
# (values are the same; set NEXTAUTH_URL to your Vercel URL)
# ============================================================

# --- REQUIRED: PostgreSQL connection string -----------------
# Supabase: Dashboard -> Connect -> Connection string -> Transaction pooler
#   postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# (The Supabase anon key is NOT a database connection string!)
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# --- REQUIRED: NextAuth --------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# --- REQUIRED: Google OAuth ----------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- REQUIRED: Gemini AI (chat + lesson generation) ----------
GEMINI_API_KEY=""

# --- OPTIONAL: Supabase public keys (Storage/Realtime later) -
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- OPTIONAL: Cloudinary (image uploads; reserved) ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- OPTIONAL: Resend (transactional email; reserved) --------
RESEND_API_KEY=""
